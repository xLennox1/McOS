# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Keep this secret server-only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Set a long random secret only while creating the first administrator.
# Remove it from Vercel after the admin account has been bootstrapped.
MCOS_SETUP_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Set to the deployed origin, e.g. https://mcos.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
